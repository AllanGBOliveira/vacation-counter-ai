# ==============================================
# VACATION COUNTER AI - Environment Variables
# ==============================================
# Copy this file to .env and update the values
# .env is gitignored and should NOT be committed

# ==============================================
# APPLICATION
# ==============================================
NUXT_PUBLIC_APP_NAME=Vacation Counter AI
NUXT_PUBLIC_APP_VERSION=1.0.0

# ==============================================
# GITHUB PAGES
# ==============================================
# IMPORTANTE: Atualize com o nome do seu repositório
# Exemplo: Se seu repo é github.com/usuario/meu-repo
# então use: /meu-repo/
NUXT_PUBLIC_BASE_URL=/vacation-counter-ai/

# ==============================================
# API CONFIGURATION
# ==============================================
# Base URL da API (se tiver backend)
NUXT_PUBLIC_API_BASE_URL=https://api.example.com

# Timeout para requisições em milissegundos
NUXT_PUBLIC_API_TIMEOUT=30000

# ==============================================
# FEATURE FLAGS
# ==============================================
# Habilita analytics (true/false)
NUXT_PUBLIC_ENABLE_ANALYTICS=false

# Habilita modo debug (true/false)
NUXT_PUBLIC_ENABLE_DEBUG=true

# ==============================================
# ANALYTICS (OPCIONAL)
# ==============================================
# Google Analytics ID (se usar)
# NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ==============================================
# BUILD-TIME ONLY (NÃO VÃO PARA O BUNDLE)
# ==============================================
# Use para tokens/secrets necessários apenas durante o build
# Essas variáveis NÃO estarão disponíveis no client
# SECRET_BUILD_TOKEN=your-secret-token-here
